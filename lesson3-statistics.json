ss=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">nσ</span></span></span></span>","key":"Xnb5dY1JkO"},{"type":"text","value":". What percentage of the PDF does this integral account for, for each n?","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mJBsfcF09i"}],"key":"AGhscNo5DR"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"tzUjBmKlGn"},{"type":"link","url":"https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.quantile.html","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"inlineCode","value":"scipy.stats.quantile","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"KhEvdzDCjN"}],"urlSource":"https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.quantile.html","key":"zbs9Hqo4NT"},{"type":"text","value":" to calculate these quantiles.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"MdSmJ7sKWt"}],"key":"PdEAE9eKtp"},{"type":"image","url":"/build/undefined","alt":"Gaussian","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"qYNgTzPdfA","urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8c/Standard_deviation_diagram.svg/2560px-Standard_deviation_diagram.svg.png"}],"identifier":"u8l14bwqtmoq","label":"U8L14bwQTMoq","html_id":"u8l14bwqtmoq","key":"BSvwWkoZev"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/","height":368},"executionInfo":{"elapsed":345,"status":"ok","timestamp":1758025435315,"user":{"displayName":"Willow Fortino","userId":"05833894673252937134"},"user_tz":-120},"id":"VRIbg8FUWlFm","outputId":"07e9ab88-f535-4699-b931-a2874d2feee6"},"children":[{"type":"code","lang":"python","executable":true,"value":"support = np.linspace(-100, 100, num=100_001)\n\nmu = 0\nsd = 1\npdf = stats.norm.pdf(support, loc=mu, scale=sd)\n\nfig, ax = plt.subplots(figsize=(5, 3))\nax.plot(support, pdf)\n\ncolors = [\n    \"blue\", \"green\", \"orange\", \"yellow\", \"red\"\n]\n\nintegrals = []\nfor i, n in enumerate(range(1, 5+1)):\n    bounds = (mu - n * sd, mu + n * sd)\n    ind = np.where(np.logical_and(support >= bounds[0], support <= bounds[1]))[0]\n    integrals.append(np.trapezoid(pdf[ind], x=support[ind]))\n\n    ax.axvline(x=bounds[0], color=\"black\", ls=\":\")\n    ax.axvline(x=bounds[1], color=\"black\", ls=\":\")\n\n    ind_neg = np.where(np.logical_and(support >= mu - n * sd, support <= mu - (n-1) * sd))[0]\n    ind_pos = np.where(np.logical_and(support >= mu + (n-1) * sd, support <= mu + n * sd))[0]\n\n    \n\n    ax.fill_between(support[ind_neg], y1=pdf[ind_neg], color=colors[i], alpha=0.5)\n    ax.fill_between(support[ind_pos], y1=pdf[ind_pos], color=colors[i], alpha=0.5)\n\nax.set_xlim((-6, 6))\nax.set_ylim((0, None))\n\nfig.show()","identifier":"vribg8fuwlfm-code","enumerator":"6","html_id":"vribg8fuwlfm-code","key":"o9cLVSASCk"},{"type":"outputs","id":"hZL33LcYzarR8ADv9Emo3","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/var/folders/4f/d1ds3nbj355830gn3smjnr900000gn/T/ipykernel_46774/2214055332.py:34: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  fig.show()\n"},"children":[],"identifier":"vribg8fuwlfm-outputs-0","html_id":"vribg8fuwlfm-outputs-0","key":"eEkCgvaxxN"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"daecc7036e58068218aab5b716bc78f5","path":"/build/daecc7036e58068218aab5b716bc78f5.png"},"text/plain":{"content":"<Figure size 500x300 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"vribg8fuwlfm-outputs-1","html_id":"vribg8fuwlfm-outputs-1","key":"vRPwjTsRTY"}],"identifier":"vribg8fuwlfm-outputs","html_id":"vribg8fuwlfm-outputs","key":"DPrxZjM99t"}],"identifier":"vribg8fuwlfm","label":"VRIbg8FUWlFm","html_id":"vribg8fuwlfm","key":"vzY153WXXT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.stats import norm\n\n# Generate x-values for the standard normal distribution (Mean=0, Std=1)\nx = np.linspace(-4, 4, 1000)\ny = norm.pdf(x, loc=0, scale=1)\n\nfig, ax = plt.subplots(figsize=(6, 3))\nax.axvline(x=-3, ls=\":\", c=\"k\")\nax.axvline(x=-2, ls=\":\", c=\"k\")\nax.axvline(x=-1, ls=\":\", c=\"k\")\nax.axvline(x=1, ls=\":\", c=\"k\")\nax.axvline(x=2, ls=\":\", c=\"k\")\nax.axvline(x=3, ls=\":\", c=\"k\")\n\nax.plot(x, y, 'k')\n\n# Define distinct color regions from left to right\n# Pairs of boundaries, associated hex colors, and text strings to display\n# regions = [\n#     (-3, -2, '#4682B4', '2.1%'),\n#     (-2, -1, '#87CEEB', '13.6%'),\n#     (-1,  1, '#ADD8E6', '68.2%'),\n#     (1,   2, '#87CEEB', '13.6%'),\n#     (2,   3, '#4682B4', '2.1%')\n# ]\n\nregions = [\n    (-3, -2, '#ADD8E6', '2.1%'),\n    (-2, -1, '#87CEEB', '13.6%'),\n    (-1,  1, '#4682B4', '68.2%'),\n    (1,   2, '#87CEEB', '13.6%'),\n    (2,   3, '#ADD8E6', '2.1%')\n]\n\n\n\n# Fill each region and place text at its specific center\nfor lower, upper, color, percentage in regions:\n    # Shade region\n    ix = np.linspace(lower, upper, 200)\n    iy = norm.pdf(ix)\n    ax.fill_between(ix, iy, color=color, alpha=0.7)\n    \n    # Calculate unique x-center for this specific slice\n    x_center = (lower + upper) / 2\n    \n    # Position text slightly above the baseline or curve depending on the region\n    # y_pos = norm.pdf(x_center) / 3 if lower != -1 else 0.15\n    y_pos = 0.5\n    \n    # Add percentage label\n    ax.text(\n        x_center,\n        y_pos,\n        percentage,\n        ha='center', va='center',\n        # fontsize=11,\n        # fontweight='bold',\n        color='black',\n        # bbox=dict(facecolor='white', alpha=0.6, edgecolor='none', boxstyle='round,pad=0.2'),\n    )\n\n# Customize plot layout\nax.set_xlabel('Standard Deviation')\nax.set_ylabel('Probability Density Function')\n\n# Set grid and strict ticks\nax.set_xticks(range(-3, 4))\nax.set_xticklabels([f'{i}$\\sigma$' if i != 0 else '0' for i in range(-3, 4)])\nax.set_ylim(bottom=0, top=0.55)\nax.set_xlim((-3.5, 3.5))\nplt.tight_layout()\nfig.savefig(\"stddevs.pdf\")\nfig.show()","key":"LEdsK6zGu5"},{"type":"outputs","id":"iJwhhOyo3iPpJAeDcSoak","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"<>:71: SyntaxWarning: invalid escape sequence '\\s'\n<>:71: SyntaxWarning: invalid escape sequence '\\s'\n/var/folders/4f/d1ds3nbj355830gn3smjnr900000gn/T/ipykernel_46774/2249548926.py:71: SyntaxWarning: invalid escape sequence '\\s'\n  ax.set_xticklabels([f'{i}$\\sigma$' if i != 0 else '0' for i in range(-3, 4)])\n/var/folders/4f/d1ds3nbj355830gn3smjnr900000gn/T/ipykernel_46774/2249548926.py:76: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  fig.show()\n"},"children":[],"key":"mLyx3aQSBo"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"518a8200df29e4682642c7de00f94d0d","path":"/build/518a8200df29e4682642c7de00f94d0d.png"},"text/plain":{"content":"<Figure size 600x300 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"AVktIHJXNi"}],"key":"xTNIrTz9lJ"}],"key":"UuA7WL2TwD"}],"key":"jckjLJjnha"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Learning Questions","url":"/lecture-1","group":"Chapter 3: Statistics"},"next":{"title":"Learning Questions","url":"/l